{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FTC: Set up Android SDK (first run)",
      "type": "process", "command": "bash",
      "args": ["${workspaceFolder}/cloud/setup.sh"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "FTC: Run simulator",
      "type": "process", "command": "python3",
      "args": ["${workspaceFolder}/cloud/run.py"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "FTC: Check compilation",
      "type": "process", "command": "python3",
      "args": ["${workspaceFolder}/cloud/run.py", "--compile-only"],
      "problemMatcher": []
    }
  ]
}
